{
  "name": "lume-desktop",
  "version": "0.6.1",
  "private": true,
  "description": "Companheiro de desktop para Windows",
  "author": "Projeto Lume",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "test": "node --test tests/ai.test.js tests/local-tools.test.js tests/reminder-parser.test.js tests/commands.test.js"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "digital.lume.desktop",
    "productName": "Lume",
    "artifactName": "Lume-Setup-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "app.js",
      "ai-errors.js",
      "local-tools.js",
      "reminder-parser.js",
      "commands.js",
      "chat-context.js"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lume",
      "runAfterFinish": true,
      "language": "1046"
    }
  }
}
